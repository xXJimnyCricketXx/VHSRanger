<!-- Cassette Number Collision Modal -->
<div id="cassetteModal" class="fixed inset-0 z-[200] hidden bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="card-theme w-full max-w-lg rounded-3xl p-8 shadow-2xl relative animate-in zoom-in duration-200 max-h-[90vh] flex flex-col">

        <div class="text-center mb-6 flex-shrink-0">
            <div class="w-14 h-14 rounded-full bg-yellow-500/10 text-yellow-500 flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-tag text-2xl"></i>
            </div>
            <h2 class="text-xl font-black mb-1">Kassettennummer bereits vergeben</h2>
            <p class="text-sm opacity-60">
                Die Nummer <span id="cassetteNumberLabel" class="font-bold"></span> wird schon verwendet. Zu welcher Kassette gehört dieser Film?
            </p>
        </div>

        <div id="cassetteGroupList" class="space-y-2 overflow-y-auto flex-grow mb-4 pr-1"></div>

        <div class="flex flex-col gap-2 flex-shrink-0">
            <button id="cassetteNewBtn"
                class="w-full bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 font-bold py-3 rounded-xl transition-all active:scale-95">
                Neue Kassette (<span id="cassetteSuggestion"></span> verwenden)
            </button>
            <button onclick="closeCassetteModal()"
                class="w-full text-sm opacity-40 hover:opacity-70 py-2 transition-opacity">
                Abbrechen
            </button>
        </div>
    </div>
</div>

<script>
    let _cassetteResolveFn = null;
    let _cassetteInputEl = null;
    let _cassetteSuggestion = '';

    function closeCassetteModal() {
        document.getElementById('cassetteModal').classList.add('hidden');
        _cassetteResolveFn = null;
        _cassetteInputEl = null;
    }

    function pickCassetteNumber(number) {
        if (_cassetteInputEl) _cassetteInputEl.value = number;
        const fn = _cassetteResolveFn;
        closeCassetteModal();
        if (fn) fn();
    }

    async function checkCassetteNumber(cassetteNumber, excludeId, inputEl, onProceed) {
        const val = (cassetteNumber || '').trim();
        if (!val) { onProceed(); return; }
        try {
            const params = new URLSearchParams({ cassette_number: val });
            if (excludeId) params.set('excludeId', excludeId);
            const res = await fetch(`<%= baseUrl %>/api/check-cassette-number?${params}`);
            const data = await res.json();

            if (!data.taken) { onProceed(); return; }

            _cassetteResolveFn = onProceed;
            _cassetteInputEl = inputEl;
            _cassetteSuggestion = data.suggestion;

            document.getElementById('cassetteNumberLabel').textContent = val;
            document.getElementById('cassetteSuggestion').textContent = data.suggestion;

            const list = document.getElementById('cassetteGroupList');
            list.innerHTML = '';
            data.groups.forEach(g => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'w-full text-left p-3 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white transition-all active:scale-95';
                btn.innerHTML = `<span class="font-bold">${g.number}</span> <span class="opacity-60">&ndash; ${g.titles.join(', ')}</span>`;
                btn.addEventListener('click', () => pickCassetteNumber(g.number));
                list.appendChild(btn);
            });

            document.getElementById('cassetteModal').classList.remove('hidden');
        } catch (e) {
            onProceed();
        }
    }

    document.getElementById('cassetteNewBtn').addEventListener('click', () => {
        pickCassetteNumber(_cassetteSuggestion);
    });
</script>
