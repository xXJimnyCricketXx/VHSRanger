<%- include('partials/header') %>

    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <div class="max-w-screen-lg mx-auto pb-20 px-4">

        <div class="text-center mb-8 md:mb-12 pt-4 md:pt-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary-theme/10 text-primary-theme mb-4">
                <i class="fa-solid fa-film text-3xl"></i>
            </div>
            <h1 class="text-3xl md:text-4xl font-black"><%= t('add_vhs.title') %></h1>
            <p class="opacity-60 mt-2"><%= t('add_vhs.desc') %></p>
        </div>

        <form action="<%= baseUrl %>/search-tmdb" method="POST" class="max-w-2xl mx-auto mb-10">

            <div class="flex flex-col sm:flex-row gap-3">
                <div class="flex-grow relative group">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none z-10">
                        <i class="fa-solid fa-search opacity-50 group-focus-within:text-primary-theme transition-colors"></i>
                    </div>
                    <input type="text" name="query" value="<%= locals.searchQuery || '' %>"
                        class="block w-full p-4 pl-12 text-base bg-black/5 dark:bg-white/5 border border-transparent focus:border-primary-theme rounded-2xl focus:ring-2 focus:ring-primary-theme/50 placeholder-opacity-50 transition-all outline-none"
                        placeholder="<%= t('add_vhs.search_placeholder') %>" required autofocus>
                </div>

                <button type="submit"
                    class="bg-primary-theme hover:brightness-110 text-white font-bold px-8 py-4 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-search"></i>
                    <%= t('common.search') %>
                </button>
            </div>

            <div class="flex items-center gap-3 mt-6 justify-center">
                <span class="text-xs font-bold uppercase opacity-30"><%= t('add_vhs.separator_or') %></span>
            </div>

            <div class="flex flex-col sm:flex-row justify-center gap-3 mt-3">
                <button id="start-scan" type="button"
                    class="bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 active:scale-95">
                    <i class="fa-solid fa-barcode"></i>
                    <span><%= t('add_vhs.btn_scan') %></span>
                </button>
                <a href="<%= baseUrl %>/add-vhs/manual"
                    class="bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 active:scale-95">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span><%= t('add_vhs.btn_manual') %></span>
                </a>
            </div>

            <div id="reader"
                class="hidden mt-6 w-full rounded-2xl overflow-hidden border border-black/10 dark:border-white/10 shadow-lg">
            </div>
        </form>

        <% if (locals.results) { %>
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl font-bold transition-colors">
                    <%= t('add_vhs.results_title') %>
                </h2>
                <span
                    class="bg-black/10 dark:bg-white/10 text-xs font-mono px-2 py-1 rounded opacity-70 transition-colors">
                    <%= results.length %>
                </span>
            </div>

            <% if (results.length===0) { %>
                <div
                    class="text-center py-12 card-theme bg-opacity-50 rounded-xl border-dashed opacity-70 transition-colors">
                    <i class="fa-solid fa-ghost text-4xl mb-3 opacity-50"></i>
                    <p>
                        <%= t('add_vhs.no_results') %>
                    </p>
                </div>
                <% } else { %>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        <% results.forEach(item=> { %>
                            <a href="<%= baseUrl %>/confirm-vhs/<%= item.id %>"
                                class="card-theme rounded-xl overflow-hidden hover:border-primary-theme transition-all group flex flex-col hover:shadow-lg hover:-translate-y-1">
                                <div class="relative aspect-[2/3] bg-black/5 dark:bg-white/5">
                                    <% if(item.cover_image) { %>
                                        <img src="<%= item.cover_image %>" class="w-full h-full object-cover">
                                        <% } else { %>
                                            <div class="w-full h-full flex items-center justify-center opacity-30">
                                                <i class="fa-solid fa-film text-3xl"></i>
                                            </div>
                                            <% } %>
                                </div>

                                <div class="p-3 flex flex-col flex-grow">
                                    <h3 class="font-bold text-sm leading-tight mb-1 line-clamp-2 transition-colors">
                                        <%= item.title %>
                                    </h3>

                                    <p class="opacity-60 text-[10px] mb-2 transition-colors">
                                        <%= item.year %>
                                    </p>

                                    <% if(item.overview) { %>
                                        <p class="opacity-60 text-[10px] line-clamp-3 mt-auto">
                                            <%= item.overview %>
                                        </p>
                                        <% } %>
                                </div>
                            </a>
                            <% }) %>
                    </div>
                    <% } %>
                        <% } %>
    </div>

    <script>
        const scanTranslations = {
            btnDefault: '<i class="fa-solid fa-barcode text-primary-theme text-xl"></i> <span><%- JSON.stringify(t("add_vhs.btn_scan")).slice(1, -1) %></span>',
            init: '<i class="fa-solid fa-spinner fa-spin text-xl"></i> <span><%- JSON.stringify(t("add_vhs.scan_init")).slice(1, -1) %></span>',
            stop: '<i class="fa-solid fa-xmark text-xl"></i> <span><%- JSON.stringify(t("add_vhs.scan_stop")).slice(1, -1) %></span>',
            found: '<i class="fa-solid fa-check text-xl"></i> <span><%- JSON.stringify(t("add_vhs.scan_found")).slice(1, -1) %></span>',
            error: <%- JSON.stringify(t("add_vhs.scan_error")) %>
        };

        const html5QrCode = new Html5Qrcode("reader");
        const scanButton = document.getElementById('start-scan');
        const readerDiv = document.getElementById('reader');
        const searchInput = document.querySelector('input[name="query"]');
        const form = document.querySelector('form[action="<%= baseUrl %>/search-tmdb"]');
        let isScanning = false;

        scanButton.addEventListener('click', () => {
            if (isScanning) {
                html5QrCode.stop().then(() => {
                    readerDiv.classList.add('hidden');
                    scanButton.innerHTML = scanTranslations.btnDefault;

                    scanButton.classList.remove('bg-red-600', 'hover:bg-red-500', 'text-white');
                    scanButton.classList.add('bg-black/5', 'dark:bg-white/5', 'hover:bg-black/10', 'dark:hover:bg-white/10');

                    isScanning = false;
                }).catch(err => console.error("Erreur stop scan", err));
            } else {
                readerDiv.classList.remove('hidden');
                scanButton.innerHTML = scanTranslations.init;

                const config = {
                    fps: 10,
                    qrbox: { width: 250, height: 150 },
                    aspectRatio: 1.0,
                    formatsToSupport: [
                        Html5QrcodeSupportedFormats.EAN_13,
                        Html5QrcodeSupportedFormats.UPC_A,
                        Html5QrcodeSupportedFormats.UPC_E
                    ]
                };
                html5QrCode.start(
                    { facingMode: "environment" },
                    config,
                    (decodedText) => {
                        html5QrCode.stop().then(() => {
                            readerDiv.classList.add('hidden');
                            scanButton.innerHTML = scanTranslations.found;
                            searchInput.value = decodedText;
                            form.submit();
                        });
                    },
                    (errorMessage) => { }
                ).then(() => {
                    isScanning = true;
                    scanButton.innerHTML = scanTranslations.stop;

                    scanButton.classList.remove('bg-black/5', 'dark:bg-white/5', 'hover:bg-black/10', 'dark:hover:bg-white/10');
                    scanButton.classList.add('bg-red-600', 'hover:bg-red-500', 'text-white');
                }).catch(err => {
                    console.error("Erreur start scan", err);
                    scanButton.innerHTML = scanTranslations.error;
                });
            }
        });
    </script>

    <%- include('partials/footer') %>
