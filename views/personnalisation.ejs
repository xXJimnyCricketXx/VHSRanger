<%- include('partials/header') %>

    <div class="max-w-5xl mx-auto px-4 py-10">

        <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-black transition-colors">
                    <%= t('perso.title') %>
                </h1>
                <p class="opacity-60 mt-1 transition-colors">
                    <%= t('perso.subtitle', { siteName: settings.siteName }) %>
                </p>
            </div>
            <a href="<%= baseUrl || '/' %>"
                class="w-fit px-4 py-2 bg-black/5 dark:bg-white/10 rounded-lg text-sm font-bold hover:bg-black/10 dark:hover:bg-white/20 transition-all flex items-center">
                <i class="fa-solid fa-arrow-left mr-2"></i>
                <%= t('perso.backHome') %>
            </a>
        </div>

        <form action="<%= baseUrl %>/admin/personnalisation/save" method="POST" class="space-y-8">

            <div class="card-theme rounded-3xl p-6 shadow-xl transition-colors">
                <h2 class="text-xl font-bold mb-6 flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center">
                        <i class="fa-solid fa-palette"></i>
                    </div>
                    <%= t('perso.themes.title') %>
                </h2>

                <div class="max-w-md relative group">
                    <select name="preset"
                        class="select-theme w-full bg-black/5 dark:bg-black/20 border border-transparent focus:border-primary-theme rounded-xl pl-4 py-3 focus:ring-2 focus:ring-primary-theme/20 outline-none transition-all">
                        <% for (const [key, val] of Object.entries(presets)) { %>
                            <option value="<%= key %>" <%= (settings.theme && settings.theme.preset === key) ? 'selected' : '' %>
                                class="dark:bg-neutral-900">
                                <%= val.label %>
                            </option>
                            <% } %>
                    </select>
                    <i class="fa-solid fa-chevron-down text-[10px] opacity-20 group-hover:opacity-60 transition-all absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                </div>
            </div>



            <div class="card-theme rounded-3xl p-6 shadow-xl transition-colors mt-8">
                <h2 class="text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center">
                        <i class="fa-solid fa-chart-simple"></i>
                    </div>
                    <%= t('perso.widgets_title') %>
                </h2>
                <p class="text-sm opacity-60 mb-6">
                    <%= t('perso.widgets_desc') %>
                </p>

                <div class="flex flex-wrap gap-2 md:gap-3">
                    <% const statOptions=[
                        { id: 'total' , label: t('stats.total_label') },
                        { id: 'films' , label: t('stats.films_label') },
                        { id: 'originals' , label: t('stats.originals_label') },
                        { id: 'genre', label: t('stats.top_genre_label') },
                        { id: 'actor', label: t('stats.top_actor_label') },
                        { id: 'director' , label: t('stats.top_director_label') },
                        { id: 'totalValue', label: t('stats.value_label') }
                    ] %>
                        <% statOptions.forEach(opt=> { %>
                            <label class="cursor-pointer group relative">
                                <input type="checkbox" name="statsWidgets" value="<%= opt.id %>"
                                    <%=(settings.statsWidgets &&
                                    settings.statsWidgets.includes(opt.id)) ? 'checked' : '' %>
                                class="sr-only">
                                <div
                                    class="flex items-center gap-2 px-4 py-2.5 rounded-xl border-2 border-transparent bg-black/5 dark:bg-white/5 opacity-80 transition-all duration-300 font-bold group-hover:bg-black/10 dark:group-hover:bg-white/10 group-has-[:checked]:bg-[var(--highlight)] group-has-[:checked]:text-[var(--highlight-text)] group-has-[:checked]:border-[var(--highlight)] group-has-[:checked]:opacity-100 group-has-[:checked]:shadow-lg group-has-[:checked]:-translate-y-0.5">
                                    <i
                                        class="fa-solid fa-plus text-[10px] opacity-40 block group-has-[:checked]:hidden transition-transform"></i>
                                    <i
                                        class="fa-solid fa-check text-[10px] hidden group-has-[:checked]:block transition-transform"></i>
                                    <span class="text-sm">
                                        <%= opt.label %>
                                    </span>
                                </div>
                            </label>
                            <% }) %>
                </div>
            </div>


            <div class="flex justify-end pt-4">
                <button type="submit"
                    class="w-full md:w-auto px-10 py-4 bg-primary-theme text-white font-black rounded-2xl hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary-theme/20 flex items-center justify-center gap-3">
                    <i class="fa-solid fa-save"></i>
                    <%= t('perso.save') %>
                </button>
            </div>
        </form>
    </div>

    <%- include('partials/footer') %>
