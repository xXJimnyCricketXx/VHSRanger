<%- include('partials/header') %>

    <div class="relative -mx-6 -mt-6 h-[260px] sm:h-[340px] md:h-[440px] overflow-hidden">
        <% if (tape.backdrop_image) { %>
            <img src="<%= tape.backdrop_image %>" class="absolute inset-0 w-full h-full object-cover">
        <% } else { %>
            <img src="<%= tape.cover_image %>" class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-40">
        <% } %>
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-page)] via-[var(--bg-page)]/70 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--bg-page)]/70 via-transparent to-transparent"></div>

        <nav class="absolute top-4 left-4 md:top-6 md:left-6 z-20">
            <% if (tape.in_wishlist) { %>
                <a href="<%= baseUrl %>/wishlist"
                    class="bg-black/40 backdrop-blur-md text-white text-sm px-4 py-2 rounded-full hover:bg-black/60 transition-colors flex items-center gap-2 shadow-lg">
                    <i class="fa-solid fa-arrow-left"></i>
                    <%= t('detail.back_to_wishlist') %>
                </a>
            <% } else { %>
                <a href="<%= baseUrl %>/collection"
                    class="bg-black/40 backdrop-blur-md text-white text-sm px-4 py-2 rounded-full hover:bg-black/60 transition-colors flex items-center gap-2 shadow-lg">
                    <i class="fa-solid fa-arrow-left"></i>
                    <%= t('detail.back_to_collection') %>
                </a>
            <% } %>
        </nav>
    </div>

    <div class="max-w-screen-xl mx-auto px-4 pb-20">

        <!-- Poster + title, overlapping the hero -->
        <div class="relative -mt-20 sm:-mt-28 md:-mt-36 z-10 flex flex-col md:flex-row gap-6 md:gap-8 items-center md:items-end mb-10">
            <div class="w-32 sm:w-40 md:w-52 flex-shrink-0">
                <div class="relative aspect-[2/3] rounded-xl overflow-hidden shadow-2xl card-theme border-4 border-[var(--bg-card)] group">
                    <img id="mainImage" src="<%= tape.user_image || tape.cover_image %>"
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" alt="Cover">
                    <span id="imageBadge"
                        class="absolute top-2 right-2 bg-white/90 dark:bg-black/60 backdrop-blur-md text-neutral-900 dark:text-white text-[10px] px-2 py-0.5 rounded-full border border-black/5 dark:border-white/10 shadow-sm transition-colors">
                        <%= tape.user_image ? t('detail.additional_image') : t('detail.official_cover') %>
                    </span>
                </div>
                <% if (tape.user_image) { %>
                    <div class="flex gap-2 mt-3 justify-center">
                        <button onclick="switchImage('<%= tape.user_image %>', translations.additional_image)"
                            class="thumb-btn w-10 h-10 rounded-lg border-2 border-primary-theme overflow-hidden relative transition-all focus:outline-none shadow-md">
                            <img src="<%= tape.user_image %>" class="w-full h-full object-cover">
                        </button>
                        <button onclick="switchImage('<%= tape.cover_image %>', translations.official_cover)"
                            class="thumb-btn w-10 h-10 rounded-lg border-2 border-transparent hover:border-black/20 dark:hover:border-white/20 overflow-hidden relative transition-all opacity-70 hover:opacity-100 focus:outline-none shadow-sm">
                            <img src="<%= tape.cover_image %>" class="w-full h-full object-cover">
                        </button>
                    </div>
                <% } %>
            </div>

            <div class="flex-grow text-center md:text-left pb-1 min-w-0">
                <h1 class="text-2xl sm:text-3xl md:text-5xl font-black mb-1 leading-tight transition-colors">
                    <%= tape.title %>
                </h1>
                <% if (tape.tagline) { %>
                    <p class="text-sm italic opacity-50 mb-1"><%= tape.tagline %></p>
                <% } %>
                <h2 class="text-lg md:text-xl text-primary-theme font-semibold mb-3 transition-colors">
                    <%= tape.director %>
                </h2>

                <div class="flex flex-wrap justify-center md:justify-start gap-2">
                    <span
                        class="px-3 py-1 rounded-full text-xs font-bold tracking-wider <%= tape.is_original === false ? 'bg-amber-500 text-white' : 'bg-primary-theme text-white' %> shadow-sm">
                        <i class="fa-solid <%= tape.is_original === false ? 'fa-video' : 'fa-certificate' %> mr-1"></i>
                        <%= tape.is_original === false ? t('vhs.recording_badge') : t('vhs.original_badge') %>
                    </span>
                    <% if (tape.year) { %>
                        <span class="px-3 py-1 bg-black/5 dark:bg-white/10 border border-transparent rounded-full text-xs opacity-80 transition-colors"><%= tape.year %></span>
                    <% } %>
                    <% if (tape.runtime) { %>
                        <span class="px-3 py-1 bg-black/5 dark:bg-white/10 border border-transparent rounded-full text-xs opacity-80 transition-colors"><%= tape.runtime %> min</span>
                    <% } %>
                    <span class="px-3 py-1 bg-black/5 dark:bg-white/10 border border-transparent rounded-full text-xs opacity-80 transition-colors"><%= tape.format_type %></span>
                    <% if(tape.age_rating) { %>
                        <span class="px-3 py-1 bg-primary-theme/10 border border-primary-theme/20 text-primary-theme rounded-full text-xs flex items-center gap-2 transition-colors">
                            <i class="fa-solid fa-shield-halved"></i> <%= tape.age_rating %>
                        </span>
                    <% } %>
                    <% if(tape.condition) { %>
                        <span class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 rounded-full text-xs flex items-center gap-2 transition-colors" title="<%= t('confirm_vhs.condition_label') %>">
                            <i class="fa-solid fa-folder-open"></i> <%= t('vhs.condition.' + tape.condition) %>
                        </span>
                    <% } %>
                    <span class="px-3 py-1 bg-black/5 dark:bg-white/10 border border-transparent rounded-full text-xs opacity-80 transition-colors">
                        <%= t('confirm_vhs.field_quantity') %> : <%= tape.quantity || 1 %>
                    </span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">

            <!-- Main column -->
            <div class="lg:col-span-2 space-y-8 min-w-0">

                <% if (tape.overview) { %>
                    <div>
                        <h3 class="text-lg font-bold mb-3 flex items-center gap-2 transition-colors">
                            <i class="fa-solid fa-align-left opacity-50"></i>
                            <%= t('confirm_vhs.field_overview') %>
                        </h3>
                        <p class="text-sm leading-relaxed opacity-70 transition-colors">
                            <%= tape.overview %>
                        </p>
                    </div>
                <% } %>

                <div>
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2 transition-colors">
                        <i class="fa-solid fa-users opacity-50"></i>
                        <%= t('detail.cast_title') %>
                    </h3>
                    <% if(tape.cast && tape.cast.length > 0) { %>
                        <div class="flex gap-4 overflow-x-auto pb-2 custom-scrollbar">
                            <% tape.cast.forEach((member) => { %>
                                <a href="<%= baseUrl %>/collection?search=<%= encodeURIComponent(member.name) %>"
                                    class="group flex-shrink-0 w-20 sm:w-24 text-center" title="<%= member.name %>">
                                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden bg-black/10 dark:bg-white/10 mb-2 shadow-md mx-auto ring-2 ring-transparent group-hover:ring-primary-theme transition-all">
                                        <% if (member.photo) { %>
                                            <img src="<%= member.photo %>" class="w-full h-full object-cover">
                                        <% } else { %>
                                            <div class="w-full h-full flex items-center justify-center opacity-30"><i class="fa-solid fa-user text-2xl"></i></div>
                                        <% } %>
                                    </div>
                                    <p class="text-xs font-bold truncate group-hover:text-primary-theme transition-colors"><%= member.name %></p>
                                    <p class="text-[10px] opacity-50 truncate"><%= member.character %></p>
                                </a>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="card-theme rounded-xl flex flex-col items-center justify-center py-10 opacity-40">
                            <i class="fa-solid fa-users text-3xl mb-3 opacity-50"></i>
                            <p class="text-sm italic"><%= t('detail.no_cast') %></p>
                        </div>
                    <% } %>
                </div>

                <% if (tape.trailer_key) { %>
                    <div>
                        <h3 class="text-lg font-bold mb-4 flex items-center gap-2 transition-colors">
                            <i class="fa-solid fa-clapperboard opacity-50"></i>
                            <%= t('detail.watch_trailer') %>
                        </h3>
                        <div id="trailerContainer"
                            class="relative aspect-video rounded-2xl overflow-hidden card-theme cursor-pointer group shadow-sm"
                            onclick="playTrailer()">
                            <img src="https://img.youtube.com/vi/<%= tape.trailer_key %>/hqdefault.jpg" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/50 flex items-center justify-center transition-colors">
                                <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-white/90 flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-play text-2xl md:text-3xl text-black ml-1"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>

                <% if (tape.comments) { %>
                    <div class="card-theme rounded-xl p-6 border border-black/10 dark:border-white/10 relative overflow-hidden shadow-sm transition-colors">
                        <div class="absolute -right-2 -top-2 text-black/5 dark:text-white/5 text-6xl">
                            <i class="fa-solid fa-quote-right"></i>
                        </div>
                        <h3 class="text-xs uppercase font-bold opacity-50 mb-3 flex items-center gap-2 relative z-10">
                            <i class="fa-regular fa-comment-dots"></i>
                            <%= t('detail.personal_notes') %>
                        </h3>
                        <p class="text-sm leading-relaxed whitespace-pre-line relative z-10 transition-colors">
                            <%= tape.comments %>
                        </p>
                    </div>
                <% } %>

                <% if (user.isAdmin) { %>
                    <div class="pt-6 border-t border-black/10 dark:border-white/10 flex flex-wrap justify-end gap-4 transition-colors">
                        <div class="flex-1 flex gap-2">
                            <% if (user && user.isAdmin && tape.tmdb_id) { %>
                                <button id="refreshInfoBtn"
                                    onclick="refreshMetadata('<%= tape._id %>', '<%= tape.tmdb_id %>')"
                                    class="opacity-60 hover:opacity-100 px-4 py-2 text-sm transition-colors border border-black/10 dark:border-white/10 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 flex items-center gap-2">
                                    <i class="fa-solid fa-arrows-rotate" id="refreshInfoIcon"></i>
                                    <%= t('collection.refresh_metadata_btn') %>
                                </button>
                            <% } %>
                        </div>
                        <a href="<%= baseUrl %>/vhs/edit/<%= tape._id %>"
                            class="opacity-70 hover:opacity-100 hover:text-primary-theme px-4 py-2 text-sm transition-colors border border-black/10 dark:border-white/10 rounded-lg hover:bg-black/5 dark:hover:bg-white/5">
                            <i class="fa-solid fa-pen-to-square mr-2"></i>
                            <%= t('common.edit') %>
                        </a>
                        <button onclick="confirmDelete('<%= tape._id %>')"
                            class="text-red-600 dark:text-red-500 hover:text-red-700 dark:hover:text-red-400 bg-red-100 dark:bg-red-500/10 hover:bg-red-200 dark:hover:bg-red-500/20 px-4 py-2 rounded-lg text-sm transition-colors">
                            <i class="fa-solid fa-trash mr-2"></i>
                            <%= t('admin.tooltips.delete') %>
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1 space-y-6 min-w-0">

                <div class="card-theme rounded-xl p-6 grid grid-cols-2 gap-y-5 gap-x-4 transition-colors shadow-sm">
                    <div class="col-span-2">
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('common.location') %>
                        </span>
                        <span class="text-sm font-medium">
                            <i class="fa-solid fa-box-archive mr-2 opacity-50"></i>
                            <%= tape.location || t('common.not_specified') %>
                        </span>
                    </div>

                    <div class="col-span-2">
                        <span class="block text-xs opacity-50 uppercase font-bold mb-2">
                            <%= t('confirm_vhs.field_genres') %>
                        </span>
                        <% if (tape.genres && tape.genres.length > 0) { %>
                            <div class="flex flex-wrap gap-2">
                                <% tape.genres.forEach(genre=> { %>
                                    <span class="px-2 py-0.5 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-md text-[11px] font-medium transition-colors">
                                        <%= genre %>
                                    </span>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <span class="text-sm font-medium"><%= tape.genre || t('common.not_specified') %></span>
                        <% } %>
                    </div>

                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('confirm_vhs.distributor_label') %>
                        </span>
                        <span class="font-medium text-sm transition-colors">
                            <%= tape.distributor || 'N/A' %>
                        </span>
                    </div>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('confirm_vhs.catalog_label') %>
                        </span>
                        <span class="font-mono text-sm bg-black/5 dark:bg-white/5 px-2 py-1 rounded transition-colors">
                            <%= tape.catalog_number || 'N/A' %>
                        </span>
                    </div>
                    <% if(tape.cassette_number) { %>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('confirm_vhs.cassette_number_label') %>
                        </span>
                        <span class="font-mono text-sm bg-black/5 dark:bg-white/5 px-2 py-1 rounded transition-colors">
                            <%= tape.cassette_number %>
                        </span>
                    </div>
                    <% } %>
                    <% if(tape.barcode) { %>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('confirm_vhs.barcode_label') %>
                        </span>
                        <span class="font-mono text-sm bg-black/5 dark:bg-white/5 px-2 py-1 rounded transition-colors inline-flex items-center gap-2">
                            <%= tape.barcode %>
                            <% if(tape.barcode_locked) { %>
                                <i class="fa-solid fa-lock text-[10px] text-primary-theme opacity-50"></i>
                            <% } %>
                        </span>
                    </div>
                    <% } %>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('confirm_vhs.region_label') %>
                        </span>
                        <span class="font-medium text-sm transition-colors">
                            <%= tape.region || 'N/A' %>
                        </span>
                    </div>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('confirm_vhs.country') %>
                        </span>
                        <span class="font-medium text-sm transition-colors">
                            <%= tape.country || 'N/A' %>
                        </span>
                    </div>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('detail.added_at') %>
                        </span>
                        <span class="text-sm transition-colors">
                            <%= new Date(tape.added_at).toLocaleDateString(currentLng==='de' ? 'de-DE' : (currentLng==='fr' ? 'fr-FR' : 'en-US') ) %>
                        </span>
                    </div>
                    <% if (tape.tmdb_id || tape.imdb_id) { %>
                    <div>
                        <span class="block text-xs opacity-50 uppercase font-bold mb-1">
                            <%= t('detail.source') %>
                        </span>
                        <div class="flex items-center gap-3">
                            <% if (tape.tmdb_id) { %>
                            <a href="https://www.themoviedb.org/movie/<%= tape.tmdb_id %>" target="_blank"
                                class="text-primary-theme hover:underline text-sm inline-flex items-center gap-1 transition-colors">
                                TMDb <i class="fa-solid fa-external-link-alt text-[10px]"></i>
                            </a>
                            <% } %>
                            <% if (tape.imdb_id) { %>
                            <a href="https://www.imdb.com/title/<%= tape.imdb_id %>" target="_blank"
                                class="text-primary-theme hover:underline text-sm inline-flex items-center gap-1 transition-colors">
                                IMDb <i class="fa-solid fa-external-link-alt text-[10px]"></i>
                            </a>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                </div>

                <div class="card-theme rounded-xl p-6 transition-colors shadow-sm">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-xs opacity-50 uppercase font-bold">
                            <%= t('detail.estimation_title') %>
                        </span>
                        <a href="https://www.ebay.de/sch/i.html?_nkw=<%= encodeURIComponent(tape.title + ' VHS') %>" target="_blank"
                            class="text-xs bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-2 py-1 rounded transition-colors flex items-center gap-1 border border-transparent">
                            <i class="fa-brands fa-ebay"></i>
                            <%= t('detail.search_ebay_btn') %>
                        </a>
                    </div>

                    <% if (tape.is_original === false) { %>
                        <div class="text-sm opacity-40 italic">
                            <%= t('detail.no_estimate_recording') %>
                        </div>
                    <% } else if (tape.estimated_price && tape.estimated_price.value) { %>
                        <div class="flex flex-col gap-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-2xl font-black text-primary-theme">
                                    <%=
                                        new Intl.NumberFormat(currentLng === 'de' ? 'de-DE' : 'en-US', {
                                            style: 'currency',
                                            currency: tape.estimated_price.currency || 'EUR',
                                            minimumFractionDigits: 2,
                                            maximumFractionDigits: 2
                                        }).format(tape.estimated_price.value * (tape.quantity || 1))
                                    %>
                                </span>
                                <% if (tape.estimated_price.updated_at) { %>
                                <span class="text-xs opacity-40">
                                    Stand: <%= new Date(tape.estimated_price.updated_at).toLocaleDateString(currentLng === 'de' ? 'de-DE' : 'en-US') %>
                                </span>
                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-sm opacity-40 italic">
                            <%= t('detail.no_estimate') %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        const translations = {
            official_cover: <%- JSON.stringify(t('detail.official_cover')) %>,
            additional_image: <%- JSON.stringify(t('detail.additional_image')) %>,
            confirm_delete: <%- JSON.stringify(t('detail.confirm_delete')) %>,
            error_server: <%- JSON.stringify(t('messages.generic_error')) %>
        };

        function switchImage(url, text) {
            const mainImg = document.getElementById('mainImage');
            const badge = document.getElementById('imageBadge');

            mainImg.style.opacity = '0.5';

            setTimeout(() => {
                mainImg.src = url;
                badge.innerText = text;
                mainImg.style.opacity = '1';
            }, 150);

            document.querySelectorAll('.thumb-btn').forEach(btn => {
                btn.classList.remove('border-primary-theme', 'opacity-100', 'ring-2', 'ring-primary-theme/50');
                btn.classList.add('border-transparent', 'opacity-70');

                if (btn.querySelector('img').src === url) {
                    btn.classList.remove('border-transparent', 'opacity-70');
                    btn.classList.add('border-primary-theme', 'opacity-100', 'ring-2', 'ring-primary-theme/50');
                }
            });
        }

        function playTrailer() {
            const container = document.getElementById('trailerContainer');
            if (!container) return;
            container.outerHTML = `<div class="relative aspect-video rounded-2xl overflow-hidden shadow-sm">
                <iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/<%= tape.trailer_key %>?autoplay=1"
                    title="Trailer" frameborder="0"
                    allow="accelerate-compute; autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen></iframe>
            </div>`;
        }

        async function confirmDelete(id) {
            if (confirm(translations.confirm_delete)) {
                try {
                    const response = await fetch(`<%= baseUrl %>/api/vhs/${id}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const data = await response.json();

                    if (data.success) {
                        window.location.href = '<%= baseUrl %>' + data.redirectUrl;
                    } else {
                        alert(`${translations.error_server}: ${data.error}`);
                    }
                } catch (err) {
                    console.error(err);
                    alert(translations.error_server);
                }
            }
        }

        async function refreshMetadata(tapeId, tmdbId) {
            const btn = document.getElementById('refreshInfoBtn');
            const icon = document.getElementById('refreshInfoIcon');

            if (!btn || btn.disabled) return;

            btn.disabled = true;
            icon.classList.add('fa-spin');

            try {
                const response = await fetch(`<%= baseUrl %>/api/vhs/${tapeId}/refresh-info`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tmdbId })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    window.location.reload();
                } else {
                    alert(<%- JSON.stringify(t('detail.refresh_info_error')) %>);
                    btn.disabled = false;
                    icon.classList.remove('fa-spin');
                }
            } catch (err) {
                console.error(err);
                alert(<%- JSON.stringify(t('detail.refresh_info_error')) %>);
                btn.disabled = false;
                icon.classList.remove('fa-spin');
            }
        }
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.2);
            border-radius: 3px;
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.2);
        }
    </style>

    <%- include('partials/footer') %>
