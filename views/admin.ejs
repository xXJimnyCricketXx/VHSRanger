    </div>

    <%- include('partials/footer') %>

        <script src="<%= baseUrl %>/socket.io/socket.io.js"></script>
        <script>
            function toggleModal(id) {
                const modal = document.getElementById(id);
                modal.classList.toggle('hidden');
                document.body.style.overflow = modal.classList.contains('hidden') ? 'auto' : 'hidden';
            }

            document.getElementById('backupInput').onchange = function (e) {
                const file = e.target.files[0];
                if (!file) return;
                if (confirm(<%- JSON.stringify(t('admin.backup.confirm_import')) %>)) {
                    const reader = new FileReader();
                    reader.onload = async (event) => {
                        try {
                            const backupData = JSON.parse(event.target.result);
                            const response = await fetch('<%= baseUrl %>/backup/import', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(backupData)
                            });
                            if (response.ok) {
                                alert(<%- JSON.stringify(t('admin.backup.import_success')) %>);
                                window.location.href = '<%= baseUrl %>/login';
                            } else {
                                alert(<%- JSON.stringify(t('admin.backup.import_error')) %>);
                            }
                        } catch (err) {
                            alert(<%- JSON.stringify(t('admin.backup.json_error')) %>);
                        }
                    };
                    reader.readAsText(file);
                }
                this.value = '';
            };

            const socket = io({
                path: '<%= baseUrl %>/socket.io',
            });

            function interpolate(str, params) {
                return str.replace(/{{(.*?)}}/g, (_, key) => {
                    return params[key.trim()] ?? '';
                });
            }

            window.translations = {
                areyousure: <%- JSON.stringify(t('admin.areyousure')) %>,
                deleteConfirm: <%- JSON.stringify(t('admin.delete_confirm')) %>,
                refreshAllConfirm: <%- JSON.stringify(t('admin.maintenance.refresh_all_confirm')) %>,
                statusStarting: <%- JSON.stringify(t('admin.maintenance.status_starting')) %>,
                statusInit: <%- JSON.stringify(t('admin.maintenance.status_init')) %>,
                statusProcessing: <%- JSON.stringify(t('admin.maintenance.status_processing')) %>,
                statusFinished: <%- JSON.stringify(t('admin.maintenance.status_finished')) %>,
                statusError: <%- JSON.stringify(t('admin.maintenance.status_error')) %>,
                itemsUpdated: <%- JSON.stringify(t('admin.modal.import_done')) %>,
                backupRestoreConfirm: <%- JSON.stringify(t('admin.backup.list.restore_confirm')) %>,
                backupDeleteConfirm: <%- JSON.stringify(t('admin.backup.list.delete_confirm')) %>,
                backupListEmpty: <%- JSON.stringify(t('admin.backup.list.empty')) %>,
                dangerWipeSuccess: <%- JSON.stringify(t('admin.danger.wipe_success')) %>,
                dangerCollectionWord: <%- JSON.stringify(t('admin.danger.wipe_collection_confirm_word')) %>,
                dangerWishlistWord: <%- JSON.stringify(t('admin.danger.wipe_wishlist_confirm_word')) %>
            };

            let activeRefreshKind = null;

            async function startMetadataRefresh(kind = 'VHS') {
                if (!confirm(window.translations.refreshAllConfirm)) return;

                activeRefreshKind = kind;

                const mode = document.getElementById('refreshMode' + kind).value;
                const btn = document.getElementById('btnRefresh' + kind);
                const icon = document.getElementById('iconRefresh' + kind);
                const text = document.getElementById('textRefresh' + kind);
                const progressContainer = document.getElementById('progressContainer' + kind);

                btn.disabled = true;
                btn.classList.add('opacity-50', 'cursor-not-allowed');
                icon.className = 'fa-solid fa-spinner fa-spin';
                text.innerText = window.translations.statusStarting;
                progressContainer.classList.remove('hidden');

                try {
                    const url = '<%= baseUrl %>/admin/refresh-all-vhs-metadata';

                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ mode })
                    });

                    if (!response.ok) {
                        const data = await response.json();
                        throw new Error(data.error || window.translations.statusError);
                    }
                } catch (err) {
                    alert(err.message);
                    btn.disabled = false;
                    btn.classList.remove('opacity-50', 'cursor-not-allowed');
                    icon.className = 'fa-solid fa-play';
                    text.innerText = <%- JSON.stringify(t("admin.maintenance.refresh_all_btn")) %>;
                    progressContainer.classList.add('hidden');
                    activeRefreshKind = null;
                }
            }

            socket.on('refresh_all_progress', (data) => {
                if (!activeRefreshKind) return;
                const k = activeRefreshKind;
                const percent = Math.round((data.current / data.total) * 100);
                const statusText = window.translations.statusProcessing.replace('{{current}}', data.current).replace('{{total}}', data.total);

                document.getElementById('progressBar' + k).style.width = `${percent}%`;
                document.getElementById('progressPercent' + k).innerText = `${percent}%`;
                document.getElementById('progressTitle' + k).innerText = statusText;
                document.getElementById('progressItem' + k).innerText = data.title;
                document.getElementById('textRefresh' + k).innerText = statusText;
            });

            socket.on('refresh_all_finished', (data) => {
                if (!activeRefreshKind) return;
                const k = activeRefreshKind;
                document.getElementById('progressTitle' + k).innerText = window.translations.statusFinished;
                document.getElementById('textRefresh' + k).innerText = window.translations.statusFinished;
                document.getElementById('iconRefresh' + k).className = 'fa-solid fa-check text-green-500';

                setTimeout(() => {
                    alert(`${data.count} ${window.translations.itemsUpdated}`);
                    window.location.reload();
                }, 1000);
            });

            async function confirmDeleteLast() {
                const count = parseInt(document.getElementById('deleteCount')?.value);
                const kind = 'VHS';
                const kindLabel = <%- JSON.stringify(t('media.vhs')) %>;

                if (!count || count < 1) return;

                const message = interpolate(window.translations.areyousure, {
                    count,
                    kindLabel
                });

                const confirmed = confirm(message);
                if (!confirmed) return;

                const errorBox = document.getElementById('deleteLastError');
                const errorText = document.getElementById('deleteLastErrorText');
                const successBox = document.getElementById('deleteLastSuccess');
                const successText = document.getElementById('deleteLastSuccessText');
                errorBox.classList.add('hidden');
                successBox.classList.add('hidden');

                try {
                    const response = await fetch('<%= baseUrl %>/admin/delete-last-items', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ count, kind })
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Erreur');

                    successText.innerText = interpolate(
                        window.translations.deleteConfirm,
                        { count: data.deleted }
                    );
                    successBox.classList.remove('hidden');
                    document.getElementById('deleteCount').value = '';
                } catch (err) {
                    errorText.innerText = err.message;
                    errorBox.classList.remove('hidden');
                }
            }

            function formatBackupDate(iso) {
                return new Date(iso).toLocaleString('<%= currentLng === "de" ? "de-DE" : "en-US" %>');
            }

            function renderBackupList(backups) {
                const list = document.getElementById('backupList');
                if (!backups || backups.length === 0) {
                    list.innerHTML = `<p class="text-xs opacity-50 italic" id="backupListEmpty">${window.translations.backupListEmpty}</p>`;
                    return;
                }
                list.innerHTML = backups.map(b => `
                    <div class="flex items-center justify-between gap-2 p-3 rounded-xl bg-black/5 dark:bg-white/5" data-filename="${b.name}">
                        <div class="overflow-hidden">
                            <div class="text-xs font-bold truncate">${formatBackupDate(b.createdAt)}</div>
                            <div class="text-[10px] opacity-50">${(b.size / 1024).toFixed(1)} KB</div>
                        </div>
                        <div class="flex gap-1 flex-shrink-0">
                            <button onclick="restoreBackup('${b.name}')" class="w-8 h-8 flex items-center justify-center bg-black/5 dark:bg-white/5 hover:bg-yellow-500 hover:text-white rounded-lg transition-colors">
                                <i class="fa-solid fa-clock-rotate-left text-xs"></i>
                            </button>
                            <button onclick="deleteBackupFile('${b.name}')" class="w-8 h-8 flex items-center justify-center bg-black/5 dark:bg-white/5 hover:bg-red-600 hover:text-white rounded-lg transition-colors">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            async function createBackupNow() {
                const btn = document.getElementById('btnCreateBackupNow');
                const icon = document.getElementById('iconCreateBackupNow');
                btn.disabled = true;
                icon.className = 'fa-solid fa-circle-notch fa-spin';
                try {
                    const res = await fetch('<%= baseUrl %>/backup/backups/create', { method: 'POST' });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Error');
                    renderBackupList(data.backups);
                } catch (err) {
                    alert(err.message);
                } finally {
                    btn.disabled = false;
                    icon.className = 'fa-solid fa-plus';
                }
            }

            async function restoreBackup(filename) {
                if (!confirm(window.translations.backupRestoreConfirm)) return;
                try {
                    const res = await fetch(`<%= baseUrl %>/backup/backups/${encodeURIComponent(filename)}/restore`, { method: 'POST' });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Error');
                    window.location.href = '<%= baseUrl %>/login';
                } catch (err) {
                    alert(err.message);
                }
            }

            async function deleteBackupFile(filename) {
                if (!confirm(window.translations.backupDeleteConfirm)) return;
                try {
                    const res = await fetch(`<%= baseUrl %>/backup/backups/${encodeURIComponent(filename)}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Error');
                    document.querySelector(`#backupList [data-filename="${filename}"]`)?.remove();
                    if (!document.querySelector('#backupList [data-filename]')) renderBackupList([]);
                } catch (err) {
                    alert(err.message);
                }
            }

            // Danger Zone: wipe buttons stay disabled until the exact
            // confirmation phrase is typed, mirroring GitHub's "type to confirm".
            function checkDangerInput(kind) {
                const input = document.getElementById('wipe' + kind + 'Input');
                const btn = document.getElementById('btnWipe' + kind);
                const required = kind === 'Collection' ? window.translations.dangerCollectionWord : window.translations.dangerWishlistWord;
                btn.disabled = input.value !== required;
            }

            async function wipeDanger(kind) {
                const input = document.getElementById('wipe' + kind + 'Input');
                const btn = document.getElementById('btnWipe' + kind);
                const endpoint = kind === 'Collection' ? '/admin/danger/wipe-collection' : '/admin/danger/wipe-wishlist';

                btn.disabled = true;
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';

                try {
                    const res = await fetch('<%= baseUrl %>' + endpoint, { method: 'POST' });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Error');
                    alert(interpolate(window.translations.dangerWipeSuccess, { count: data.deleted }));
                    window.location.reload();
                } catch (err) {
                    alert(err.message);
                    btn.innerHTML = originalText;
                    input.value = '';
                    checkDangerInput(kind);
                }
            }
        </script>
