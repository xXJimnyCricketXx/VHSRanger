<%- include('partials/header') %>

    <div class="max-w-screen-xl mx-auto px-1 md:px-0 pb-12">

        <div class="flex items-center justify-between mb-6 md:mb-8 pt-6">

            <h1 class="text-3xl font-bold flex flex-col md:flex-row md:items-center gap-2 md:gap-3 transition-colors truncate mr-4">
                <span class="flex items-center gap-3">
                    <span class="w-2 h-7 md:h-8 bg-primary-theme rounded-full inline-block flex-shrink-0"></span>
                    <span class="truncate">
                        <%= t('wishlist.title') %>
                    </span>
                </span>
                <span
                    class="px-3 md:mt-1.5 py-1 bg-primary-theme rounded-full text-sm font-bold w-fit">
                    <%= tapes.length %>
                        <%= t('common.items') %>
                </span>
            </h1>

            <div class="flex gap-2">
                <a href="<%= baseUrl %>/print/wishlist" target="_blank"
                    class="flex-shrink-0 w-10 h-10 md:w-auto md:px-4 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center gap-2 group"
                    title="Drucken / Als PDF speichern">
                    <i class="fa-solid fa-print group-hover:scale-110 transition-transform"></i>
                    <span class="hidden md:inline text-xs font-bold uppercase tracking-widest">Drucken</span>
                </a>
            </div>

        </div>

        <%- include('partials/collection-filters') %>

        <% if (tapes.length===0) { %>
            <div
                class="text-center py-16 md:py-20 card-theme rounded-xl border-dashed opacity-80 transition-colors shadow-sm">
                <i class="fa-regular fa-heart text-5xl md:text-6xl opacity-20 mb-4 transition-colors"></i>
                <p class="opacity-60 px-4">
                    <%= t('wishlist.empty_msg') %>
                </p>
                <a href="<%= baseUrl %>/add-vhs"
                    class="text-primary-theme hover:underline mt-2 inline-block font-medium transition-colors">
                    <%= t('wishlist.search_link') %>
                </a>
            </div>
            <% } else { %>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
                    <% tapes.forEach(tape=> { %>
                        <% const detailUrl=`/vhs/${tape._id}`; %>

                            <div
                                class="group relative card-theme rounded-xl hover:border-primary-theme transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between overflow-hidden">
                                <a href="<%= baseUrl + detailUrl %>" class="block flex-grow">
                                    <div
                                        class="aspect-[2/3] w-full relative overflow-hidden bg-black/5 dark:bg-white/5 flex items-center justify-center">

                                        <img src="<%= tape.cover_image %>"
                                            class="relative z-10 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                            loading="lazy">

                                        <span
                                            class="absolute top-1.5 right-1.5 md:top-2 md:right-2 z-20 text-[10px] font-bold px-1.5 py-0.5 md:px-2 md:py-1 rounded backdrop-blur-md border border-white/10 shadow-sm opacity-90 bg-[var(--highlight)] text-[var(--highlight-text)]">
                                            <%= t('media.vhs') %>
                                        </span>
                                    </div>

                                    <div class="p-3">
                                        <h3 class="font-bold text-xs md:text-sm truncate leading-tight mb-0.5"
                                            title="<%= tape.title %>">
                                            <%= tape.title %>
                                        </h3>
                                        <p class="text-[10px] md:text-xs opacity-60 truncate mb-2">
                                            <%= tape.director || 'Unknow' %>
                                        </p>

                                        <% if(tape.is_original === false) { %>
                                            <div class="flex items-center gap-1 mb-1">
                                                <span
                                                    class="w-2 h-2 rounded-full bg-primary-theme inline-block flex-shrink-0"></span>
                                                <span class="text-[9px] md:text-[10px] opacity-60 truncate max-w-full">
                                                    <%= t('media.recording') %>
                                                </span>
                                            </div>
                                            <% } %>
                                    </div>
                                </a>

                                <% if (user.isAdmin) { %>
                                    <button onclick="moveToCollection('<%= tape._id %>')"
                                        class="w-full py-2.5 md:py-2 bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white text-primary-theme text-[10px] md:text-xs font-bold uppercase transition-colors flex items-center justify-center gap-1.5 border-t border-black/10 dark:border-white/10 active:brightness-90">
                                        <i class="fa-solid fa-check"></i>
                                        <span>
                                            <%= t('wishlist.btn_received') %>
                                        </span>
                                    </button>
                                    <% } %>
                            </div>
                            <% }) %>
                </div>
                <% } %>
    </div>

    <script>
        const wishlistTranslations = {
            confirmMove: <%- JSON.stringify(t('wishlist.confirm_move')) %>,
            serverError: <%- JSON.stringify(t('messages.generic_error')) %>
        };

        async function moveToCollection(id) {
            if (confirm(wishlistTranslations.confirmMove)) {
                try {
                    const res = await fetch(`<%= baseUrl %>/api/vhs/${id}/move-to-collection`, { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        window.location.reload();
                    }
                } catch (e) {
                    alert(wishlistTranslations.serverError);
                }
            }
        }
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.2);
            border-radius: 2px;
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
        }
    </style>

    <%- include('partials/footer') %>
