MONGODB_URL=mongodb://mongodb:27017/vhsranger

# Long random secret that signs login tokens. The app refuses to start with this
# example value. Generate one with: openssl rand -hex 32
PASSJWT=SomeComplexPassword

# HTTPS Configuration
PROD=false # Change to true ONLY if you use HTTPS. If not, leave as false.

# User and group that own the uploads and backups folders. Without them the folders
# keep their owner, and a folder owned by root goes to 1000.
PUID=1000
PGID=1000

# Time zone for scheduled backups and log times
TZ=Europe/Berlin

# VHSRanger
VHS_PORT=3098

# Base URL for serving on a sub-path, leave empty to serve from root (default)
BASE_URL=

# TMDb - optional, app works without token, but metadata lookup (title, cover,
# cast, description) will not work without it
# Get your free API Read Access Token at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# eBay Browse API - optional, only used for the "estimate price" helper button.
# Get free production keys at: https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
