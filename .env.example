MONGODB_URL=mongodb://mongodb:27017/vhsranger

PASSJWT=SomeComplexPassword
SESSION_SECRET=AnotherComplexSecret

# HTTPS Configuration
PROD=false # Change to true ONLY if you use HTTPS. If not, leave as false.

# VHSRanger
VHS_PORT=3098

# Base URL for serving on a sub-path, leave empty to serve from root (default)
BASE_URL=

# TMDb - optional, app works without token, but metadata lookup (title, cover,
# cast, description) will not work without it
# Get your free API key (v3 auth) at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# eBay Browse API - optional, only used for the "estimate price" helper button.
# Get free production keys at: https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
